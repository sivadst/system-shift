# =====================================================================
# SYSTEM//SHIFT: Environmental Configuration
# =====================================================================

# Server Networking
HOST=0.0.0.0
PORT=8000

# Relational Database Connection (Default: High-speed WAL SQLite)
# For PostgreSQL: postgresql://user:password@localhost:5432/system_shift
DATABASE_URL=sqlite:///./campus_operations.db

# Optional Gemini API Key for LLM Reasoning Layer
# If empty, the system automatically uses the deterministic grounded reasoner
GEMINI_API_KEY=
# Alternative key name
GOOGLE_API_KEY=

# CORS Settings
CORS_ORIGINS=["*"]

# Synthetic Telemetry Records Generation Target
SYNTHETIC_RECORDS_TARGET=100000
